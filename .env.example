# LLM providers (only the ones referenced in config are needed). Defaults: Vercel AI Gateway for the roles,
# OpenRouter for the decision model.
VERCEL_AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# GitHub (read-only is enough for public repos)
GITHUB_TOKEN=

# Telegram (phase 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Only for webhook mode (empty = long polling). Public HTTPS URL and a random secret Telegram echoes back.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# X / Twitter (phase 5) — OAuth 1.0a user context of the CM account
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Publisher logs instead of posting unless this is 0
DRY_RUN=1
