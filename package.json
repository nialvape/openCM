{
  "name": "opencm",
  "version": "0.1.0",
  "description": "Harness for a Community Manager agent for open-source projects: patch notes, X posts and a Telegram channel with the maintainer.",
  "type": "module",
  "private": true,
  "bin": {
    "opencm": "build/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13"
  },
  "author": "Joaquín Peñalva (https://github.com/nialvape)",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/openai": "^4.0.99",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.148",
    "grammy": "^1.46.0",
    "picomatch": "^4.0.7",
    "twitter-text": "^3.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/twitter-text": "^3.1.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
